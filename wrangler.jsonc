{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "fa34a072-3199-493f-90d5-e26a36964357","database_name": "web" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "dd910a6777644acc8d9a319c50752135" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
